{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "hint": "插件总开关与通用行为",
    "items": {
      "enabled": {
        "description": "插件总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后所有增强能力停止工作，但不会卸载插件、不会清理数据"
      },
      "debug_log": {
        "description": "调试日志",
        "type": "bool",
        "default": false,
        "hint": "开启后会输出检索打分、注入内容等细节，排障用，日常建议关闭"
      },
      "admin_only_commands": {
        "description": "管理命令仅管理员可用",
        "type": "bool",
        "default": true,
        "hint": "开启后 /sab 系列管理命令仅 AstrBot 管理员可执行"
      },
      "default_scope": {
        "description": "默认记忆作用域",
        "type": "string",
        "default": "session",
        "options": ["session", "user", "global"],
        "labels": ["按会话隔离", "按用户跨会话", "全局共享"],
        "hint": "决定记忆在多大范围内共享。改动只影响之后新写入的记忆"
      }
    }
  },
  "memory": {
    "description": "记忆与检索",
    "type": "object",
    "hint": "长期记忆的采集、检索与注入策略",
    "items": {
      "enabled": {
        "description": "启用长期记忆",
        "type": "bool",
        "default": true
      },
      "capture": {
        "description": "自动采集对话写入记忆",
        "type": "bool",
        "default": true,
        "hint": "关闭后仅保留手动写入与周记，不自动学习对话内容"
      },
      "capture_groups": {
        "description": "在群聊中采集",
        "type": "bool",
        "default": true
      },
      "capture_private": {
        "description": "在私聊中采集",
        "type": "bool",
        "default": true
      },
      "retrieval_top_k": {
        "description": "单次召回条数上限",
        "type": "int",
        "default": 5,
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "max_injected_chars": {
        "description": "注入记忆的字符预算上限",
        "type": "int",
        "default": 1800,
        "slider": {"min": 200, "max": 8000, "step": 100},
        "hint": "超出预算的记忆会被截断，避免挤占上下文"
      },
      "injection_method": {
        "description": "记忆注入方式",
        "type": "string",
        "default": "extra_user_content",
        "options": ["extra_user_content", "system_prompt", "disabled"],
        "labels": ["临时内容块（推荐，不写入历史）", "系统提示词", "仅检索不注入"],
        "hint": "推荐临时内容块：不污染对话历史、不破坏模型前缀缓存"
      },
      "fts_enabled": {
        "description": "启用关键词全文检索",
        "type": "bool",
        "default": true
      },
      "vector_enabled": {
        "description": "启用向量语义检索",
        "type": "bool",
        "default": true,
        "hint": "检测不到可用的 Embedding 提供商时会自动降级为纯关键词检索，不会报错"
      },
      "embedding_provider_id": {
        "description": "嵌入（Embedding）模型提供商",
        "type": "string",
        "default": "",
        "hint": "此下拉列表由插件在运行时自动填充为「嵌入模型」（而非对话模型）。留空则自动挑选第一个可用的嵌入提供商。若下拉为空，说明当前尚未配置任何嵌入提供商，可直接手动填写提供商 ID。"
      },
      "fusion_rrf_k": {
        "description": "RRF 融合常数 k",
        "type": "int",
        "default": 60,
        "slider": {"min": 10, "max": 200, "step": 10}
      },
      "time_decay_half_life_days": {
        "description": "时间衰减半衰期（天）",
        "type": "float",
        "default": 14.0,
        "slider": {"min": 1.0, "max": 180.0, "step": 1.0}
      },
      "weight_relevance": {
        "description": "相关性权重",
        "type": "float",
        "default": 0.55,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "weight_importance": {
        "description": "重要性权重",
        "type": "float",
        "default": 0.2,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "weight_recency": {
        "description": "新近度权重",
        "type": "float",
        "default": 0.25,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "min_score": {
        "description": "注入最低分阈值",
        "type": "float",
        "default": 0.05,
        "slider": {"min": 0.0, "max": 0.5, "step": 0.01}
      },
      "dedup_similarity": {
        "description": "去重相似度阈值",
        "type": "float",
        "default": 0.92,
        "slider": {"min": 0.5, "max": 1.0, "step": 0.01}
      }
    }
  },
  "reflection": {
    "description": "自我学习（反思）",
    "type": "object",
    "hint": "让 Bot 定期回顾对话，把有价值的结论沉淀为长期记忆",
    "items": {
      "enabled": {
        "description": "启用反思式自我学习",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "触发方式",
        "type": "string",
        "default": "rounds",
        "options": ["rounds", "interval", "both"],
        "labels": ["按对话轮数", "按时间间隔", "两者任一满足"]
      },
      "trigger_rounds": {
        "description": "累计多少轮对话后触发",
        "type": "int",
        "default": 30,
        "slider": {"min": 5, "max": 200, "step": 5}
      },
      "interval_minutes": {
        "description": "时间间隔（分钟）",
        "type": "int",
        "default": 720,
        "slider": {"min": 10, "max": 4320, "step": 10}
      },
      "provider_id": {
        "description": "反思所用模型（建议用较强的模型）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话默认模型"
      },
      "min_messages": {
        "description": "触发反思所需的最少新消息数",
        "type": "int",
        "default": 8,
        "slider": {"min": 2, "max": 100, "step": 1}
      },
      "approval_required": {
        "description": "反思结果需人工审批后才写入",
        "type": "bool",
        "default": false,
        "hint": "开启后反思产出进入待审队列，可用 /sab review 批准或驳回"
      },
      "max_facts_per_run": {
        "description": "单次反思最多产出记忆条数",
        "type": "int",
        "default": 5,
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "cooldown_minutes": {
        "description": "反思冷却时间（分钟）",
        "type": "int",
        "default": 60,
        "slider": {"min": 5, "max": 1440, "step": 5}
      }
    }
  },
  "journal": {
    "description": "周记（现实记忆）",
    "type": "object",
    "hint": "把用户现实生活中的记录作为高优先级记忆来源，用于构建现实与对话的桥梁",
    "items": {
      "enabled": {
        "description": "启用周记",
        "type": "bool",
        "default": true
      },
      "allow_user_write": {
        "description": "允许普通用户写周记",
        "type": "bool",
        "default": true
      },
      "admin_only_write": {
        "description": "周记仅管理员可写",
        "type": "bool",
        "default": false,
        "condition": {"basic.enabled": true}
      },
      "retrieval_boost": {
        "description": "周记召回加权",
        "type": "float",
        "default": 0.15,
        "slider": {"min": 0.0, "max": 0.5, "step": 0.05},
        "hint": "周记命中的记忆条目在最终排序中额外加分"
      },
      "weekly_reflection": {
        "description": "每周自动生成洞察",
        "type": "bool",
        "default": true,
        "hint": "固定时间让模型阅读本周周记，产出对用户的洞察并沉淀为长期记忆"
      },
      "weekly_reflection_weekday": {
        "description": "每周反思日（0=周一，6=周日）",
        "type": "int",
        "default": 6,
        "slider": {"min": 0, "max": 6, "step": 1}
      },
      "weekly_reflection_hour": {
        "description": "每周反思时刻（小时）",
        "type": "int",
        "default": 22,
        "slider": {"min": 0, "max": 23, "step": 1}
      },
      "default_tags": {
        "description": "周记默认标签",
        "type": "list",
        "default": ["生活"],
        "hint": "用户写周记未指定标签时使用"
      }
    }
  },
  "agent": {
    "description": "Agent 工具",
    "type": "object",
    "hint": "把插件能力暴露为模型的函数工具，让 Bot 主动调用（默认关闭）",
    "items": {
      "memory_tools": {
        "description": "启用记忆函数工具",
        "type": "bool",
        "default": false,
        "hint": "向模型提供「记忆检索 / 记忆写入」两个工具。会改变所有会话的模型行为并占用少量上下文，建议先在小范围会话验证效果；修改后需重载插件生效。"
      }
    }
  },
  "context": {
    "description": "上下文治理",
    "type": "object",
    "hint": "请求级压缩：估算 token，折叠早期工具/图片，必要时为更早的历史生成摘要（默认关闭）",
    "items": {
      "enabled": {
        "description": "启用上下文治理",
        "type": "bool",
        "default": false,
        "hint": "仅在估算超过「触发阈值」时生效；只影响本次请求，不改写对话历史。开启后即时生效，无需重载"
      },
      "max_tokens": {
        "description": "触发阈值与目标上限（token）",
        "type": "int",
        "default": 6000,
        "slider": {"min": 1000, "max": 60000, "step": 500},
        "hint": "估算未超过该值时不干预；超过后先折叠早期工具/图片，仍超才调用模型做摘要"
      },
      "keep_recent": {
        "description": "保留最近多少条消息原文",
        "type": "int",
        "default": 12,
        "slider": {"min": 2, "max": 100, "step": 1},
        "hint": "这些消息永不参与压缩，保证模型能看到最近几轮完整对话"
      },
      "min_messages": {
        "description": "少于多少条消息时不治理",
        "type": "int",
        "default": 8,
        "slider": {"min": 4, "max": 100, "step": 1}
      },
      "summary_provider_id": {
        "description": "摘要所用模型（建议用便宜且支持长输入的模型）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话默认模型"
      }
    }
  },
  "runtime": {
    "description": "运行与性能",
    "type": "object",
    "hint": "超时、并发与成本控制",
    "items": {
      "llm_timeout_seconds": {
        "description": "单次 LLM 调用超时（秒）",
        "type": "int",
        "default": 45,
        "slider": {"min": 5, "max": 300, "step": 5}
      },
      "max_concurrent_llm": {
        "description": "辅助 LLM 最大并发",
        "type": "int",
        "default": 2,
        "slider": {"min": 1, "max": 8, "step": 1}
      },
      "daily_llm_budget": {
        "description": "每日辅助 LLM 调用上限",
        "type": "int",
        "default": 0,
        "slider": {"min": 0, "max": 2000, "step": 10},
        "hint": "0 表示不限制；达到上限后辅助调用暂停到次日"
      },
      "task_stop_poll_ms": {
        "description": "停止感知轮询间隔（毫秒）",
        "type": "int",
        "default": 50,
        "slider": {"min": 10, "max": 500, "step": 10},
        "hint": "越小越快响应 /stop，但 CPU 开销略高"
      },
      "vector_index_max_scan": {
        "description": "向量检索最大扫描条数",
        "type": "int",
        "default": 5000,
        "slider": {"min": 100, "max": 50000, "step": 100},
        "hint": "内置向量检索为暴力余弦，上限用于防止超大记忆库拖慢主流程"
      }
    }
  }
}
