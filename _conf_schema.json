{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "hint": "插件总开关与通用行为",
    "items": {
      "enabled": {
        "description": "插件总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后所有增强能力停止工作，但不会卸载插件、不会清理数据"
      },
      "debug_log": {
        "description": "调试日志",
        "type": "bool",
        "default": false,
        "hint": "开启后会输出检索打分、注入内容等细节，排障用，日常建议关闭"
      },
      "admin_only_commands": {
        "description": "管理命令仅管理员可用",
        "type": "bool",
        "default": true,
        "hint": "开启后 /sab 系列管理命令仅 AstrBot 管理员可执行"
      },
      "default_scope": {
        "description": "默认记忆作用域",
        "type": "string",
        "default": "session",
        "options": ["session", "user", "global"],
        "labels": ["按会话隔离", "按用户跨会话", "全局共享"],
        "hint": "决定记忆在多大范围内共享。改动只影响之后新写入的记忆"
      }
    }
  },
  "memory": {
    "description": "记忆与检索",
    "type": "object",
    "hint": "长期记忆的采集、检索与注入策略",
    "items": {
      "enabled": {
        "description": "启用长期记忆",
        "type": "bool",
        "default": true
      },
      "capture": {
        "description": "自动采集对话写入记忆",
        "type": "bool",
        "default": true,
        "hint": "关闭后仅保留手动写入与周记，不自动学习对话内容"
      },
      "capture_groups": {
        "description": "在群聊中采集",
        "type": "bool",
        "default": true
      },
      "capture_private": {
        "description": "在私聊中采集",
        "type": "bool",
        "default": true
      },
      "retrieval_top_k": {
        "description": "单次召回条数上限",
        "type": "int",
        "default": 5,
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "max_injected_chars": {
        "description": "注入记忆的字符预算上限",
        "type": "int",
        "default": 1800,
        "slider": {"min": 200, "max": 8000, "step": 100},
        "hint": "超出预算的记忆会被截断，避免挤占上下文"
      },
      "injection_method": {
        "description": "记忆注入方式",
        "type": "string",
        "default": "extra_user_content",
        "options": ["extra_user_content", "system_prompt", "disabled"],
        "labels": ["临时内容块（推荐，不写入历史）", "系统提示词", "仅检索不注入"],
        "hint": "推荐临时内容块：不污染对话历史、不破坏模型前缀缓存"
      },
      "fts_enabled": {
        "description": "启用关键词全文检索",
        "type": "bool",
        "default": true
      },
      "vector_enabled": {
        "description": "启用向量语义检索",
        "type": "bool",
        "default": true,
        "hint": "检测不到可用的 Embedding 提供商时会自动降级为纯关键词检索，不会报错"
      },
      "embedding_provider_id": {
        "description": "嵌入（Embedding）模型提供商",
        "type": "string",
        "default": "",
        "hint": "此下拉列表由插件在运行时自动填充为「嵌入模型」（而非对话模型）。留空则自动挑选第一个可用的嵌入提供商。若下拉为空，说明当前尚未配置任何嵌入提供商，可直接手动填写提供商 ID。"
      },
      "fusion_rrf_k": {
        "description": "RRF 融合常数 k",
        "type": "int",
        "default": 60,
        "slider": {"min": 10, "max": 200, "step": 10}
      },
      "time_decay_half_life_days": {
        "description": "时间衰减半衰期（天）",
        "type": "float",
        "default": 14.0,
        "slider": {"min": 1.0, "max": 180.0, "step": 1.0}
      },
      "weight_relevance": {
        "description": "相关性权重",
        "type": "float",
        "default": 0.55,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "weight_importance": {
        "description": "重要性权重",
        "type": "float",
        "default": 0.2,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "weight_recency": {
        "description": "新近度权重",
        "type": "float",
        "default": 0.25,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05}
      },
      "min_score": {
        "description": "注入最低分阈值",
        "type": "float",
        "default": 0.05,
        "slider": {"min": 0.0, "max": 0.5, "step": 0.01}
      },
      "dedup_similarity": {
        "description": "去重相似度阈值",
        "type": "float",
        "default": 0.92,
        "slider": {"min": 0.5, "max": 1.0, "step": 0.01}
      },
      "rerank_enabled": {
        "description": "启用重排序（Rerank）",
        "type": "bool",
        "default": false,
        "hint": "召回后由重排序模型对候选重新打分，可明显提升 top-k 精度。需要先在 AstrBot 中配置重排序提供商；未配置或调用失败时会自动回退，不影响召回本身"
      },
      "rerank_provider_id": {
        "description": "重排序（Rerank）模型提供商",
        "type": "string",
        "default": "",
        "hint": "此下拉列表由插件在运行时自动填充为「重排序模型」。留空则自动挑选第一个可用的重排序提供商；若下拉为空，说明当前尚未配置任何重排序提供商，可直接手动填写提供商 ID"
      },
      "rerank_candidates": {
        "description": "送入重排序的候选条数",
        "type": "int",
        "default": 20,
        "slider": {"min": 2, "max": 100, "step": 1},
        "hint": "先多召回、再由模型精选；越大越准也越慢，建议取「单次召回条数上限」的 2~4 倍"
      },
      "rerank_min_candidates": {
        "description": "触发重排序的最少候选数",
        "type": "int",
        "default": 3,
        "slider": {"min": 2, "max": 20, "step": 1},
        "hint": "候选不足时跳过模型调用以省延迟（仍按回退策略处理）"
      },
      "rerank_weight": {
        "description": "重排序分权重",
        "type": "float",
        "default": 0.7,
        "slider": {"min": 0.0, "max": 1.0, "step": 0.05},
        "hint": "最终相关性 = 权重 × 重排序分 + (1-权重) × 融合分；留出余量可避免模型分完全压过重要性与新近度"
      },
      "rerank_fallback": {
        "description": "重排序不可用时的回退策略",
        "type": "string",
        "default": "lexical",
        "options": ["lexical", "none"],
        "labels": ["本地词法重排（零成本，推荐）", "不重排（仅按融合分排序）"],
        "hint": "模型未配置、调用失败或熔断时采用；词法重排只用分词结果，不消耗任何模型调用"
      }
    }
  },
  "reflection": {
    "description": "自我学习（反思）",
    "type": "object",
    "hint": "让 Bot 定期回顾对话，把有价值的结论沉淀为长期记忆",
    "items": {
      "enabled": {
        "description": "启用反思式自我学习",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "触发方式",
        "type": "string",
        "default": "rounds",
        "options": ["rounds", "interval", "both"],
        "labels": ["按对话轮数", "按时间间隔", "两者任一满足"]
      },
      "trigger_rounds": {
        "description": "累计多少轮对话后触发",
        "type": "int",
        "default": 30,
        "slider": {"min": 5, "max": 200, "step": 5}
      },
      "interval_minutes": {
        "description": "时间间隔（分钟）",
        "type": "int",
        "default": 720,
        "slider": {"min": 10, "max": 4320, "step": 10}
      },
      "provider_id": {
        "description": "反思所用模型（建议用较强的模型）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话默认模型"
      },
      "min_messages": {
        "description": "触发反思所需的最少新消息数",
        "type": "int",
        "default": 8,
        "slider": {"min": 2, "max": 100, "step": 1}
      },
      "approval_required": {
        "description": "反思结果需人工审批后才写入",
        "type": "bool",
        "default": false,
        "hint": "开启后反思产出进入待审队列，可用 /sab review 批准或驳回"
      },
      "max_facts_per_run": {
        "description": "单次反思最多产出记忆条数",
        "type": "int",
        "default": 5,
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "cooldown_minutes": {
        "description": "反思冷却时间（分钟）",
        "type": "int",
        "default": 60,
        "slider": {"min": 5, "max": 1440, "step": 5}
      }
    }
  },
  "journal": {
    "description": "周记（现实记忆）",
    "type": "object",
    "hint": "把用户现实生活中的记录作为高优先级记忆来源，用于构建现实与对话的桥梁",
    "items": {
      "enabled": {
        "description": "启用周记",
        "type": "bool",
        "default": true
      },
      "allow_user_write": {
        "description": "允许普通用户写周记",
        "type": "bool",
        "default": true
      },
      "admin_only_write": {
        "description": "周记仅管理员可写",
        "type": "bool",
        "default": false
      },
      "retrieval_boost": {
        "description": "周记召回加权",
        "type": "float",
        "default": 0.15,
        "slider": {"min": 0.0, "max": 0.5, "step": 0.05},
        "hint": "周记命中的记忆条目在最终排序中额外加分"
      },
      "weekly_reflection": {
        "description": "每周自动生成洞察",
        "type": "bool",
        "default": true,
        "hint": "固定时间让模型阅读本周周记，产出对用户的洞察并沉淀为长期记忆"
      },
      "weekly_reflection_weekday": {
        "description": "每周反思日（0=周一，6=周日）",
        "type": "int",
        "default": 6,
        "slider": {"min": 0, "max": 6, "step": 1}
      },
      "weekly_reflection_hour": {
        "description": "每周反思时刻（小时）",
        "type": "int",
        "default": 22,
        "slider": {"min": 0, "max": 23, "step": 1}
      },
      "default_tags": {
        "description": "周记默认标签",
        "type": "list",
        "default": ["生活"],
        "hint": "用户写周记未指定标签时使用"
      }
    }
  },
  "agent": {
    "description": "Agent 工具",
    "type": "object",
    "hint": "把插件能力暴露为模型的函数工具，让 Bot 主动调用（默认关闭）",
    "items": {
      "memory_tools": {
        "description": "启用记忆函数工具",
        "type": "bool",
        "default": false,
        "hint": "向模型提供「记忆检索 / 记忆写入」两个工具。会改变所有会话的模型行为并占用少量上下文，建议先在小范围会话验证效果；修改后需重载插件生效。"
      }
    }
  },
  "context": {
    "description": "上下文治理",
    "type": "object",
    "hint": "请求级压缩：估算 token，折叠早期工具/图片，必要时为更早的历史生成摘要（默认关闭）",
    "items": {
      "enabled": {
        "description": "启用上下文治理",
        "type": "bool",
        "default": false,
        "hint": "仅在估算超过「触发阈值」时生效；只影响本次请求，不改写对话历史。开启后即时生效，无需重载"
      },
      "max_tokens": {
        "description": "触发阈值与目标上限（token）",
        "type": "int",
        "default": 6000,
        "slider": {"min": 1000, "max": 60000, "step": 500},
        "hint": "估算未超过该值时不干预；超过后先折叠早期工具/图片，仍超才调用模型做摘要"
      },
      "keep_recent": {
        "description": "保留最近多少条消息原文",
        "type": "int",
        "default": 12,
        "slider": {"min": 2, "max": 100, "step": 1},
        "hint": "这些消息永不参与压缩，保证模型能看到最近几轮完整对话"
      },
      "min_messages": {
        "description": "少于多少条消息时不治理",
        "type": "int",
        "default": 8,
        "slider": {"min": 4, "max": 100, "step": 1}
      },
      "summary_provider_id": {
        "description": "摘要所用模型（建议用便宜且支持长输入的模型）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话默认模型"
      }
    }
  },
  "group": {
    "description": "群聊语义",
    "type": "object",
    "hint": "读空气：按注意力得分决定是否在群聊中主动插话，并合并短时间内的连续消息（默认关闭）",
    "items": {
      "enabled": {
        "description": "启用群聊语义",
        "type": "bool",
        "default": false,
        "hint": "关闭时插件完全不参与群聊的唤醒判定，行为与未安装插件一致；开启后即时生效"
      },
      "attention_threshold": {
        "description": "插话注意力阈值",
        "type": "float",
        "default": 0.55,
        "slider": {"min": 0.05, "max": 1.0, "step": 0.05},
        "hint": "得分低于该值就不插话；调高更沉默，调低更容易接话。被 @/引用时无视该阈值"
      },
      "cooldown_seconds": {
        "description": "两次插话的最短间隔（秒）",
        "type": "int",
        "default": 90,
        "slider": {"min": 0, "max": 1800, "step": 10}
      },
      "max_per_hour": {
        "description": "每会话每小时最多插话次数",
        "type": "int",
        "default": 6,
        "slider": {"min": 1, "max": 60, "step": 1}
      },
      "merge_window_seconds": {
        "description": "并发合并窗口（秒）",
        "type": "float",
        "default": 1.2,
        "slider": {"min": 0.0, "max": 5.0, "step": 0.2},
        "hint": "窗口内到达的同一会话消息会合并为一次请求；设为 0 关闭合并"
      },
      "merge_max_messages": {
        "description": "单次最多合并消息条数",
        "type": "int",
        "default": 4,
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "bot_aliases": {
        "description": "Bot 的称呼词",
        "type": "list",
        "default": [],
        "hint": "被这样叫时视为点名（仅在未被 @ 时作为加分信号），例如 [\"小助手\", \"bot\"]"
      },
      "whitelist": {
        "description": "只在这些人/群主动插话",
        "type": "list",
        "default": [],
        "hint": "填群号或完整会话 UMO；留空表示不限。仅约束主动插话，不影响被 @ 时的回复"
      },
      "blacklist": {
        "description": "这些人/群不主动插话",
        "type": "list",
        "default": [],
        "hint": "优先级高于白名单；同样不影响被 @ 时的回复"
      }
    }
  },
  "proactive": {
    "description": "主动交互",
    "type": "object",
    "hint": "双轨调度：按固定时间或会话静默时长主动发一条消息，受免打扰约束（默认关闭）",
    "items": {
      "enabled": {
        "description": "启用主动交互",
        "type": "bool",
        "default": false,
        "hint": "开启后即时生效，无需重载；目标会话为空时不会有任何发送"
      },
      "targets": {
        "description": "目标会话（UMO）",
        "type": "list",
        "default": [],
        "hint": "只对这些会话主动发送，不做自动发现。格式 platform:message_type:session_id"
      },
      "daily_enabled": {
        "description": "启用计划轨（每天固定时间）",
        "type": "bool",
        "default": true
      },
      "daily_time": {
        "description": "计划轨发送时间（HH:MM）",
        "type": "string",
        "default": "10:00",
        "hint": "服务器本地时间；错过的时间点会在启动后补一次"
      },
      "idle_enabled": {
        "description": "启用空闲轨（静默一段时间后搭话）",
        "type": "bool",
        "default": false
      },
      "idle_minutes": {
        "description": "空闲轨触发所需静默时长（分钟）",
        "type": "int",
        "default": 180,
        "slider": {"min": 5, "max": 1440, "step": 5}
      },
      "idle_check_minutes": {
        "description": "空闲轨检查周期（分钟）",
        "type": "int",
        "default": 15,
        "slider": {"min": 1, "max": 180, "step": 1}
      },
      "busy_guard_minutes": {
        "description": "视为「正在聊天」的静默门槛（分钟）",
        "type": "int",
        "default": 10,
        "slider": {"min": 0, "max": 120, "step": 1},
        "hint": "静默不足该时长就放弃本次发送，避免打断正在进行的对话"
      },
      "daily_max": {
        "description": "每会话每日主动消息上限",
        "type": "int",
        "default": 1,
        "slider": {"min": 1, "max": 24, "step": 1}
      },
      "quiet_start": {
        "description": "免打扰开始时间（0-23 点）",
        "type": "int",
        "default": 23,
        "slider": {"min": 0, "max": 23, "step": 1},
        "hint": "与结束时间相同表示不启用免打扰；支持跨午夜（如 23 点到 8 点）"
      },
      "quiet_end": {
        "description": "免打扰结束时间（0-23 点）",
        "type": "int",
        "default": 8,
        "slider": {"min": 0, "max": 23, "step": 1}
      },
      "max_chars": {
        "description": "主动消息长度上限",
        "type": "int",
        "default": 80,
        "slider": {"min": 10, "max": 500, "step": 10}
      },
      "material_memories": {
        "description": "取材的长期记忆条数",
        "type": "int",
        "default": 8,
        "slider": {"min": 0, "max": 30, "step": 1}
      },
      "material_journals": {
        "description": "取材的周记条数",
        "type": "int",
        "default": 3,
        "slider": {"min": 0, "max": 20, "step": 1}
      },
      "provider_id": {
        "description": "生成主动消息所用模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用会话默认模型"
      }
    }
  },
  "persona": {
    "description": "拟人化学习",
    "type": "object",
    "hint": "从对话中学习表达风格、群内用语与社交好感度，并在回复时作为参考注入（默认全部关闭）",
    "items": {
      "style": {
        "description": "启用风格模仿",
        "type": "bool",
        "default": false,
        "hint": "把「用户提问 → Bot 回答」配对成表达样本，遇到相似场景时作为 few-shot 示例注入。开启后即时生效"
      },
      "style_approval_required": {
        "description": "风格样本需人工审批",
        "type": "bool",
        "default": true,
        "hint": "开启后新学到的样本进入待审队列，用 /sab approve 批准后才生效（推荐）"
      },
      "style_max_patterns": {
        "description": "每会话最多保留样本数",
        "type": "int",
        "default": 200,
        "slider": {"min": 10, "max": 2000, "step": 10}
      },
      "style_top_k": {
        "description": "单次注入的样本条数",
        "type": "int",
        "default": 3,
        "slider": {"min": 1, "max": 10, "step": 1}
      },
      "style_min_similarity": {
        "description": "样本相似度门槛",
        "type": "float",
        "default": 0.12,
